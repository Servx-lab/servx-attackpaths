PORT=5001
# Base URL of the ServX API. The executor receives an ephemeral repository
# token only over a separately signed request; never set MONGODB_URI,
# ENCRYPTION_KEY, or a reusable GitHub token here.
SERVX_CONTROL_PLANE_URL=http://localhost:5000

# ServX API -> executor
ATTACK_PATHS_EXECUTOR_INBOUND_KEY_ID=servx-control-plane-local
ATTACK_PATHS_EXECUTOR_INBOUND_HMAC_SECRET=replace-with-a-long-random-secret

# executor -> ServX API
ATTACK_PATHS_EXECUTOR_OUTBOUND_KEY_ID=attackpaths-executor-local
ATTACK_PATHS_EXECUTOR_OUTBOUND_HMAC_SECRET=replace-with-a-different-long-random-secret
