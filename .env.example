# Public URL of the ServX API (no trailing slash).
SERVX_CONTROL_PLANE_URL=https://api.example.com

# Requests from ServX API -> this executor. Generate a unique 32+ byte random
# value, store the same value in ServX as ATTACK_PATHS_EXECUTOR_INBOUND_HMAC_SECRET.
SERVX_EXECUTOR_INBOUND_HMAC_SECRET=replace-with-a-random-hex-secret
SERVX_EXECUTOR_INBOUND_KEY_ID=servx-control-plane-2026-01

# Requests from this executor -> ServX API. This is a DIFFERENT secret; store
# the same value in ServX as ATTACK_PATHS_EXECUTOR_OUTBOUND_HMAC_SECRET.
SERVX_EXECUTOR_OUTBOUND_HMAC_SECRET=replace-with-a-second-random-hex-secret
SERVX_EXECUTOR_OUTBOUND_KEY_ID=attackpaths-executor-2026-01

# GitHub reports repository size in KiB. Deep scans reject repositories larger
# than this value before cloning; the executor also enforces a 250 MiB maximum.
ATTACK_PATHS_MAX_DEEP_REPO_SIZE_KB=102400

# Render supplies PORT automatically. This is only for local development.
PORT=5001
